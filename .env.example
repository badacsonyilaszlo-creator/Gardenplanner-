# A setup.sh ebből készíti el a .env fájlt, és a jelszavakat automatikusan, véletlenszerűen generálja.
# A .env SOHA nem kerül fel a GitHubra (benne van a .gitignore-ban).

# --- Adatbázis ---
POSTGRES_PASSWORD=__GENERALT__

# --- n8n (automatizálás) ---
N8N_ENCRYPTION_KEY=__GENERALT__
# Amíg nincs domain, a felület csak a szerveren belül érhető el.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# --- NocoDB (CRM) ---
NOCODB_JWT_SECRET=__GENERALT__

# --- Listmonk (hírlevél) ---
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=__GENERALT__
